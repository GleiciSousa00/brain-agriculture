# Banco de dados
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cadastro
POSTGRES_PASSWORD=cadastro
POSTGRES_DB=cadastro_rural

# API
API_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Documento em repouso, conforme docs/adr/0002-documento-cifrado-em-repouso.md.
# Trinta e dois bytes cada, em base64. Gere os seus com:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# A composição traz valores de desenvolvimento prontos, para que um clone recém-feito suba
# com um comando. Eles são públicos, estão em `docker-compose.yml`, e a API recusa arrancar
# com eles quando NODE_ENV é production.
#
# Perder a chave de cifra é perder a capacidade de exibir os Documentos já gravados.
# Trocar o segredo da impressão obriga a recalcular a coluna de unicidade de todas as linhas.
DOCUMENTO_ENCRYPTION_KEY=
DOCUMENTO_FINGERPRINT_SECRET=

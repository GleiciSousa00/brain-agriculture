# Copie para `.env` nesta pasta e preencha. Todo valor vazio é obrigatório.

# Exemplo: cadastro-rural.duckdns.org
DOMAIN=

# `latest` acompanha a main. Para voltar versão, use o SHA de um commit.
IMAGE_TAG=latest

LOG_LEVEL=info

# openssl rand -base64 24
POSTGRES_PASSWORD=

# Trinta e dois bytes cada, em base64: openssl rand -base64 32
# Nunca mudam depois do primeiro `up`: trocar a chave torna ilegível todo Documento gravado,
# e trocar o segredo quebra a unicidade. Ver docs/adr/0002.
DOCUMENTO_ENCRYPTION_KEY=
DOCUMENTO_FINGERPRINT_SECRET=

# Usuário e senha que o navegador pede. Senha: openssl rand -base64 18
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

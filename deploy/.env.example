# Copie para `.env` nesta mesma pasta e preencha. O `.env` fica só no servidor: o
# `.gitignore` da raiz o ignora em qualquer pasta.
#
# Todo valor vazio abaixo é obrigatório. `docker compose config` reprova enquanto faltar um.

# Domínio que aponta para o IP da VPS. O Caddy emite o certificado para ele.
# Exemplo: cadastro-rural.duckdns.org
DOMAIN=

# Tag das imagens em ghcr.io. `latest` acompanha a main. Para prender uma versão ou
# voltar atrás, use o SHA de um commit, que a pipeline publica como tag.
IMAGE_TAG=latest

# Nível de log da API.
LOG_LEVEL=info

# Senha do Postgres, só usada dentro da rede da composição. Gere com:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Documento em repouso, conforme docs/adr/0002-documento-cifrado-em-repouso.md.
# Trinta e dois bytes cada, em base64. Gere com:
#   openssl rand -base64 32
# ou, onde houver Node:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Os dois nunca mudam depois do primeiro `up`. Trocar a chave de cifra torna ilegível todo
# Documento já gravado. Trocar o segredo da impressão quebra a unicidade: o mesmo Documento
# passa a ter outra impressão e a coluna de unicidade não o reconhece mais.
DOCUMENTO_ENCRYPTION_KEY=
DOCUMENTO_FINGERPRINT_SECRET=

# Usuário e senha que o navegador pede ao abrir o site. A senha fica em claro aqui e vira
# hash no arranque do contêiner. Gere a senha com:
#   openssl rand -base64 18
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

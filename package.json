{
  "name": "brain-agriculture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "openapi": "pnpm --filter @cadastro-rural/api openapi && pnpm --filter @cadastro-rural/contracts gerar",
    "openapi:check": "pnpm openapi && git diff --exit-code -- apps/api/openapi.json packages/contracts/src/generated",
    "depcruise": "dependency-cruiser --config .dependency-cruiser.cjs apps packages",
    "audit:gate": "pnpm audit --audit-level high",
    "audit:report": "pnpm audit --audit-level moderate || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.35.0",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "^2.3.0",
      "eslint-plugin-sonarjs>minimatch": "^10.2.3"
    }
  }
}
